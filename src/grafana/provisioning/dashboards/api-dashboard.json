{
    "uid": "gin-api",
    "title": "Gin API Observability",
    "tags": [
        "gin",
        "prometheus",
        "api"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "5s",
    "time": {
        "from": "now-15m",
        "to": "now"
    },
    "panels": [
        {
            "id": 1,
            "title": "Request Rate",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum by (method, route) (rate(http_requests_total[1m]))",
                    "legendFormat": "{{method}} {{route}}",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0
                },
                "overrides": []
            }
        },
        {
            "id": 2,
            "title": "Error Rate",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 9,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum(rate(http_errors_total[1m]))",
                    "legendFormat": "Errors/sec",
                    "refId": "A"
                },
                {
                    "expr": "100 * sum(rate(http_errors_total[1m])) / clamp_min(sum(rate(http_requests_total[1m])), 0.000001)",
                    "legendFormat": "Error %",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "min": 0
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": "Error %"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "percent"
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": 3,
            "title": "Request Duration (p50, p95, p99)",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "h": 9,
                "w": 24,
                "x": 0,
                "y": 9
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p50",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p95",
                    "refId": "B"
                },
                {
                    "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p99",
                    "refId": "C"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0
                },
                "overrides": []
            }
        }
    ]
}